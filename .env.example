# Teamtype Docker Compose Configuration
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# Container image tag (default: latest)
# TEAMTYPE_TAG=latest

# Container name (default: teamtype)
# TEAMTYPE_CONTAINER_NAME=teamtype

# Host user UID and GID that owns the mounted directory (default: 1000:1000)
# On Linux, run `id -u` and `id -g` to find your current host user IDs.
# TEAMTYPE_UID=1000
# TEAMTYPE_GID=1000

# Directory on the host to synchronize (default: ./project)
# TEAMTYPE_PROJECT_DIR=./project

# share = host a directory, join = connect to somebody else's directory (default: share)
# TEAMTYPE_COMMAND=share

# Print the permanent secret address on startup (share only, default: true)
# TEAMTYPE_SHOW_SECRET_ADDRESS=true

# Skip generating a one-time Magic Wormhole join code (share only, default: false)
# TEAMTYPE_NO_JOIN_CODE=false

# Peer name displayed next to the cursor in collaborative editors (default: cloud-peer)
# TEAMTYPE_USERNAME=cloud-peer

# Permanent secret address to connect to (required when TEAMTYPE_COMMAND=join without join code)
# TEAMTYPE_PEER=

# One-time Magic Wormhole join code (used when TEAMTYPE_COMMAND=join)
# TEAMTYPE_JOIN_CODE=

# Synchronize .git/ and .jj/ directories (experimental, default: false)
# TEAMTYPE_SYNC_VCS=false

# Extra CLI arguments passed verbatim to the teamtype daemon
# Example: --iroh-relay https://relay.example.org
# TEAMTYPE_EXTRA_ARGS=
